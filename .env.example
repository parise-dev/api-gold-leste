# =====================================================================
# Gold Leste API — variáveis de ambiente
# Copie para .env e preencha com os valores reais da VPS.
# NUNCA versione o .env real nem substitua os placeholders abaixo.
# =====================================================================

# --- Aplicação -------------------------------------------------------
PORT=4000
# URL pública desta API. Usada para montar a URL dos feeds dos portais.
PUBLIC_API_URL=https://api.gold-leste.online
# Nº de proxies (Nginx) à frente da API — necessário para o rate limit.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb

# --- Banco de dados --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=troque_pelo_nome_do_banco
DB_USER=troque_pelo_usuario
DB_PASSWORD=troque_pela_senha

# --- Autenticação ----------------------------------------------------
JWT_SECRET=troque_por_um_segredo_forte

# --- MinIO (armazenamento das fotos de imóveis) ----------------------
# Use "local" somente em desenvolvimento; na VPS mantenha "minio".
MEDIA_STORAGE=minio
MINIO_ENDPOINT=minio.ensuo.com.br
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_BUCKET=empreendimentos
MINIO_PUBLIC_BASE_URL=https://minio.ensuo.com.br
# Prefixo dos objetos: imoveis/{imovelId}/{mediaId}/original.ext
MINIO_PREFIXO_IMOVEIS=imoveis
# Credenciais: obtenha no painel do MinIO. NÃO comitar valores reais.
MINIO_ACCESS_KEY=coloque_a_access_key_aqui
MINIO_SECRET_KEY=coloque_a_secret_key_aqui

# --- Credenciais de portais (cifradas em banco) ----------------------
# Chave AES-256-GCM. Gere com: openssl rand -hex 32
# Trocar esta chave torna ilegíveis as credenciais já salvas.
INTEGRACOES_CRYPTO_KEY=coloque_uma_chave_hex_de_64_caracteres

# --- Processamento de imagem ----------------------------------------
IMAGEM_LARGURA_WEB=1920
IMAGEM_LARGURA_THUMB=480
IMAGEM_QUALIDADE_WEB=82
IMAGEM_QUALIDADE_THUMB=72

# --- Limites de upload ----------------------------------------------
UPLOAD_IMAGEM_MAX_MB=15
UPLOAD_IMAGEM_MAX_ARQUIVOS=20

# --- Rate limiting (endpoints públicos) ------------------------------
RATE_LIMIT_FORM_PUBLICO=10
RATE_LIMIT_LEITURA_PUBLICA=120
RATE_LIMIT_FEED=30
RATE_LIMIT_WEBHOOK_LEADS=120
RATE_LIMIT_UPLOAD=60

# --- Diversos --------------------------------------------------------
# Prefixo do código do imóvel (GL000001, GL000002, ...)
IMOVEL_CODIGO_PREFIXO=GL
# Sal para o hash de IP dos leads (nunca guardamos o IP puro).
LEAD_IP_SALT=troque_por_um_valor_aleatorio
# Janela em dias em que o imóvel conta como "novidade" no score.
OPORTUNIDADE_DIAS_NOVIDADE=45

# ---------------------------------------------------------------------
# Fila de Leads / Próximos Corretores
# (script: sql/20260830_fila_leads.sql)
# ---------------------------------------------------------------------
# Tempo sem heartbeat até o corretor sair da fila (segundos).
FILA_PRESENCA_TIMEOUT_SEGUNDOS=120
# Intervalo de heartbeat sugerido ao frontend (segundos).
FILA_HEARTBEAT_INTERVALO_SEGUNDOS=40
# Intervalo de atualização do painel de TV (segundos).
FILA_PAINEL_POLL_SEGUNDOS=5
# Máximo de leads pendentes escoados por rodada.
FILA_MAX_PENDENTES_RODADA=25
# FILA  = rodízio entre corretores online (padrão)
# IMOVEL = comportamento anterior (responsável do imóvel)
LEAD_DISTRIBUICAO_ESTRATEGIA=FILA
